<%= link_to "Back to all operators", picop_operators_path %>

<h1><%= @operator.name %></h1>
<p><%= @operator.code %></p>
<p><%= @operator.stations_count %> stations</p>

<div class="mb-3">
  <%= link_to "Edit operator", edit_picop_operator_path(@operator), class: "btn btn-primary"  %>
</div>
<div class="mb-3">
  <%= button_to "Delete operator", picop_operator_path(@operator), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-danger" %>
</div>
