<%= link_to "Back to all users", picop_users_path %>

<h1><%= @user.screen_name %></h1>
<p><%= @user.email_address %></p>

<div class="mb-3">
  <%= link_to "Edit user", edit_picop_user_path(@user), class: "btn btn-primary"  %>
</div>
<div class="mb-3">
  <%= button_to "Delete user", picop_user_path(@user), method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Are you sure?" } %>
</div>
