<%= link_to "Back to all users", picop_users_path %>

<h1><%= @user.screen_name %></h1>
<p><%= @user.email_address %></p>

<div>
  <%= link_to "Edit user", edit_picop_user_path(@user)  %>
  <%= button_to "Delete user", picop_user_path(@user), method: :delete, data: { turbo_confirm: "Are you sure?" } %>
</div>
