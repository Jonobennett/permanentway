<h1>Stations</h1>
<table id="stationlist" class="table table-striped table-hover">
<tr>
    <th>Name</th>
    <th>CRS Code</th>
    <th>Country</th>
</tr>

<% @stations.each do |station| %>
<tr>
    <td><%= link_to station.name, picop_station_path(station) %></td>
    <td><%= station.crscode %></td>
    <td><%= station.country %></td>
</tr>
<% end %>
</table>
