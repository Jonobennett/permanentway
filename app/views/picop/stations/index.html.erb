<h1>Stations</h1>
<div><%= link_to "Upload stations", station_import_path %></div>

<div>Total stations: <%= @stations.all.count %></div>
<table id="stationlist" class="table table-striped table-hover">
<tr>
    <th>Name</th>
    <th>CRS Code</th>
    <th>Region</th>
</tr>

<% @stations.each do |station| %>
<tr>
    <td><%= link_to station.name, picop_station_path(station) %></td>
    <td><%= station.crscode %></td>
    <td><%= station.region.name %></td>
</tr>
<% end %>
</table>
