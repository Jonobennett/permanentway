<h1><%= @station.name %></h1>
<p><%= @station.crscode %></p>
<p>Operated by <%= link_to @station.operator.name, picop_operator_path(@station.operator) %></p>

<div>
  <%= link_to "Edit station", edit_picop_station_path(@station), class: "btn btn-primary"  %>
  <%= button_to "Delete station", picop_station_path(@station), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-danger" %>
</div>

