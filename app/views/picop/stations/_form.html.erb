<%= form_with model: [ :picop, station ] do |form| %>
  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, required: true, autofocus: true, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :crscode, "CRS Code", class: "form-label" %>
    <%= form.text_field :crscode, required: true, class: "form-control" %>
  </div class="mb-3">
  
  <div class="mb-3">
    <%= form.label :operator, class: "form-label" %>
    <%= form.collection_select :operator_id, Operator.order(:name), :id, :name, {}, { :class => "form-control"} %>
  </div>

  <div class="mb-3">
    <%= form.label :region, class: "form-label" %>
    <%= form.collection_select :region_id, Region.order(:name), :id, :name, {}, { :class => "form-control"} %>
  </div>

  <div class="mb-3">
    <%= form.label :lat, "Latitude", class: "form-label" %>
    <%= form.text_field :lat, required: true, class: "form-control" %>
    <%= form.label :lon, "Longitude", class: "form-label" %>
    <%= form.text_field :lon, required: true, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>