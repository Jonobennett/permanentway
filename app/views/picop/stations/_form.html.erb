<%= form_with model: [ :picop, station ] do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name, required: true, autofocus: true %>
  </div>

  <div class="mb-3">
    <%= form.label :operator, class: "form-label" %>
    <%= form.collection_select :operator_id, Operator.order(:name), :id, :name %>
  </div>

  <div class="mb-3">
    <%= form.label :crscode, class: "form-label" %>
    <%= form.text_field :crscode, required: true, class: "form-control" %>
  </div class="mb-3">

  <div class="mb-3">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>