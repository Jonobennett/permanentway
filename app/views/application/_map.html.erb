<div id="map" class="mx-0 mp-0" style="width: 100%; height: 600px; border: solid;"></div>
<script>
    <% @stations.each do |station| %>
        L.marker(
            [<%= station.lat %>,<%= station.lon %>],
            {
                icon: <%= station.map_icon %>,
                riseOnHover: true
            }
        ).addTo(<%= station.map_layer %>)
        .bindPopup(
            '<%= link_to station.name, station_path(station.crscode), class: "pway-maplink" %>'
        );
    <% end %>

    const map = new PwayMap('map');
    
    passed_through.addTo(map);
    called_at.addTo(map);
    changed.addTo(map);

    const layerControl = L.control.layers(baseMaps, overlayMaps, {collapsed: false}).addTo(map);

    let unvisited = L.layerGroup();
 
    <% @unvisited.each do |station| %>
        L.marker([<%= station.lat %>,<%= station.lon %>] , {riseOnHover: true, icon: unvisitedIcon}).addTo(unvisited).bindPopup('<%= link_to station.name, station_path(station.crscode), class: "pway-maplink" %>');
    <% end %>

    <% if local_assigns[:showunvisited] %>
        unvisited.addTo(map);
    <% end %>

    layerControl.addOverlay(unvisited, "Unvisited");
    
</script>
