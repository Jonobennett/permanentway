<div id="map" style="width: 100%; height: 600px;"></div>
<script>
	const transport = L.tileLayer('https://api.thunderforest.com/transport/{z}/{x}/{y}.png?apikey=ff72333a30dd47c8911006adaa025bb4', {
		maxZoom: 19,
		attribution: 'Maps &copy; <a href="https://www.thunderforest.com/">Thunderforest</a>, Data &copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
	});

	const osm = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
		maxZoom: 19,
		attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
	});
    
    var baseMaps = {
        "OpenStreetMap": osm,
        "Transport map": transport
    };

    var PwayIcon = L.Icon.extend({
        options: {
            iconSize:     [20, 33],
            iconAnchor:   [10, 33],
            popupAnchor:  [-3, -76]
        }
    });

    var unvisitedIcon = new PwayIcon({
        iconUrl: '<%= image_path("grey-br-icon.png")  %>'
    });

    var passedIcon = new PwayIcon({
        iconUrl: '<%= image_path("yellow-br-icon.png")  %>'
    });

    var calledAtIcon = new PwayIcon({
        iconUrl: '<%= image_path("orange-br-icon.png")  %>'
    });

    var changedIcon = new PwayIcon({
        iconUrl: '<%= image_path("blue-br-icon.png")  %>'
    });

    var gatelineIcon = new PwayIcon({
        iconUrl: '<%= image_path("green-br-icon.png")  %>'
    });

    var passed_through = L.layerGroup();
    var called_at = L.layerGroup();
    var changed = L.layerGroup();
    var gateline = L.layerGroup();

    var overlayMaps = {
        "Passed through": passed_through,
        "Called at": called_at,
        "Changed trains": changed,
        "Started/ended journey": gateline
    }; 

    <% @stations.each do |station| %>
    var visitLayer;
        switch(<%= station.visits.maximum("visit_type") %>) {
            case 1:
                visitLayer = passed_through;
                visitIcon = passedIcon;
                break;
            case 2:
                visitLayer = called_at;
                visitIcon = calledAtIcon;
                break;
            case 3:
                visitLayer = changed;
                visitIcon = changedIcon;
                break;
            case 4:
                visitLayer = gateline;
                visitIcon = gatelineIcon;
        }
        L.marker(
            [<%= station.lat %>,<%= station.lon %>],
            {
                icon: visitIcon,
                riseOnHover: true
            }).addTo(visitLayer)
            .bindPopup(
                '<%= link_to station.name, station_path(station.crscode) %>'
        );
    <% end %>

    const map = L.map('map', {
        center: [54.27,-2.66],
        zoom: 5,
        layers: [osm, gateline]
    });
    
    passed_through.addTo(map);
    called_at.addTo(map);
    changed.addTo(map);

    var layerControl = L.control.layers(baseMaps, overlayMaps, {collapsed: false}).addTo(map);

    var unvisited = L.layerGroup();
 
    <% @unvisited.each do |station| %>
        L.marker([<%= station.lat %>,<%= station.lon %>] , {riseOnHover: true, icon: unvisitedIcon}).addTo(unvisited).bindPopup('<%= link_to station.name, station_path(station.crscode) %>');
    <% end %>

    <% if local_assigns[:showunvisited] %>
        unvisited.addTo(map);
    <% end %>

    layerControl.addOverlay(unvisited, "Unvisited");
</script>
