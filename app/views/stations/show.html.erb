<% content_for :title do %><%= @station.name %> - <% end %>
<div class="bd-title border">
	<h1><%= @station.name %></h1>
	<p><%= @station.crscode %></p>
	<p><%= link_to @station.region.name, region_path(@station.region) %> region</p>
	<p>Operated by <%= link_to @station.operator.name, operator_path(@station.operator) %></p>
</div>

<div id="map" style="width: 100%; height: 600px; border: solid;"></div>
<script>
	const map = new PwayMap('map').setView([<%= @station.lat %>,<%= @station.lon %>], 13);
	const layerControl = L.control.layers(baseMaps, null, {collapsed: false}).addTo(map);
    L.marker([<%= @station.lat %>,<%= @station.lon %>]).addTo(map);
</script>

<% if authenticated? %>
	<p>You have visited this station <%= @visits.count %> times</p>
	<% if @visits.count > 0 %>
		<h4>Recent visits:</h4>
		<ul class="list-group mb-3">
			<% @visits.order(:visit_date).last(5).each do |visit| %>
				<li class="list-group-item justify-content-between">
					<img src="/ticket-detailed.svg" />
					<%= visit.visit_date.strftime('%R on %A %e %B %Y') %> - <%= visit.visit_label %> this station.
					<div>
						<%= link_to image_tag("/pencil-square.svg"), edit_visit_path(visit) %>
						<%= button_to image_tag("/trash.svg"), visit_path(visit), method: :delete, data: { turbo_confirm: "Are you sure?" }, class:"btn btn-link" %>
					</div>
				</li>
			<% end %>
		</ul>
	<% end %>
	<div><%= link_to "Record a visit", new_station_visit_path, class: "btn btn-primary" %></div>
<% end %>
