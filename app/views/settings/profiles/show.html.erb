<h1>Profile</h1>

<%= form_with model: Current.user, url: settings_profile_path do |form| %>
  <% if form.object.errors.any? %>
    <div>Error: <%= form.object.errors.full_messages.first %></div>
  <% end %>

  <div class="mb-3">
    <%= form.label :screen_name, class: "form-label" %>
    <%= form.text_field :screen_name, required: true, autocomplete: "given-name", class: "form-control" %>
  </div>

  <div>
    <%= form.submit "Update profile", class: "btn btn-primary" %>
  </div>
<% end %>